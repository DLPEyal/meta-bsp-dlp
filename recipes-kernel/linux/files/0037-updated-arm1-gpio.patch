From 8b74894f991139dd8b791154e0d85983a61911ef Mon Sep 17 00:00:00 2001
From: Oleg Strelecky <oleg_s@eyal-emi.co.il>
Date: Sun, 14 Jun 2026 14:18:05 +0300
Subject: [PATCH] updated arm1 gpio

---
 arch/arm64/boot/dts/freescale/base_arm1_gpio_named.h | 2 +-
 arch/arm64/boot/dts/freescale/basearm1.dts           | 2 +-
 arch/arm64/boot/dts/freescale/basearm2.dts           | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/base_arm1_gpio_named.h b/arch/arm64/boot/dts/freescale/base_arm1_gpio_named.h
index e19948eea409..ca89ccb01567 100755
--- a/arch/arm64/boot/dts/freescale/base_arm1_gpio_named.h
+++ b/arch/arm64/boot/dts/freescale/base_arm1_gpio_named.h
@@ -5,7 +5,7 @@
         status = "okay";
 	pin_numbers = <0 1 3 4 8 9 10 11 12>;
 	pin_names = "LED0","LED1","ARM_BUTTON","LED2","REBOOT_DEC_OUT","PROG_EN_IN","REBOOT_IN","OTP_LOCK","LED3";
-	pin_states = < GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_LOW GPIOF_IN GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_LOW GPIOF_IN GPIOF_IN GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_LOW>;
+	pin_states = < GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_LOW GPIOF_IN GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_HIGH GPIOF_IN GPIOF_IN GPIOF_OUT_INIT_LOW GPIOF_OUT_INIT_LOW>;
 
    
        
diff --git a/arch/arm64/boot/dts/freescale/basearm1.dts b/arch/arm64/boot/dts/freescale/basearm1.dts
index 9bcbf0c06540..3d81dec3c0f1 100755
--- a/arch/arm64/boot/dts/freescale/basearm1.dts
+++ b/arch/arm64/boot/dts/freescale/basearm1.dts
@@ -199,7 +199,7 @@ spidev3: spi@1 {
 &eqos {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_eqos>;
-	phy-mode = "rgmii";
+	phy-mode = "rgmii-id";
 	status = "okay";
 
          fixed-link {
diff --git a/arch/arm64/boot/dts/freescale/basearm2.dts b/arch/arm64/boot/dts/freescale/basearm2.dts
index 30c82a8fddb6..1833f64bfeb0 100755
--- a/arch/arm64/boot/dts/freescale/basearm2.dts
+++ b/arch/arm64/boot/dts/freescale/basearm2.dts
@@ -182,7 +182,7 @@ spidev3: spi@1 {
 &eqos {
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_eqos>;
-	phy-mode = "rgmii";
+	phy-mode = "rgmii-id";
 	status = "okay";
 
          fixed-link {
